{
  "name": "anadyon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:verify": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "check:migration-replay": "node scripts/check-migration-replay.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:mail": "CONFIRM_LIVE_MAIL=yes node tests/e2e/mail-live.mjs",
    "check:translation": "node scripts/check-translation.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "test:seo": "vitest run --config vitest.build.config.ts",
    "test:browser": "playwright test",
    "test:frozen-panes": "playwright test tests/browser/frozen-panes.spec.ts --config playwright.frozen-panes.config.ts",
    "backup": "node scripts/backup.mjs",
    "check:grants": "node scripts/check-grants.mjs",
    "check:schema:parity": "node scripts/check-schema-parity.mjs",
    "staging:reset": "node scripts/reset-staging.mjs",
    "staging:seed-auth": "node scripts/seed-staging-auth.mjs",
    "test:browser:all": "playwright test --config playwright.crossbrowser.config.ts",
    "probe:rpc-identity": "node scripts/probe-rpc-identity.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@sentry/nextjs": "10.72.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "googleapis": "^174.0.1",
    "lucide-react": "^1.22.0",
    "next": "^16.3.1",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.4",
    "react-google-recaptcha": "^3.1.0",
    "resend": "^6.16.0",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "jsdom": "^30.0.1",
    "supabase": "2.116.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
