{
  "name": "anadyon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prebuild": "node scripts/check-deployment-boundary.mjs",
    "dev": "next dev",
    "build": "next build",
    "build:verify": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "node --max-old-space-size=4096 node_modules/typescript/bin/tsc --noEmit",
    "check:migration-replay": "node scripts/check-migration-replay.mjs",
    "check:schema": "node scripts/check-schema-drift.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --maxWorkers=2",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:mail": "CONFIRM_LIVE_MAIL=yes node tests/e2e/mail-live.mjs",
    "check:translation": "node scripts/check-translation.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:links": "node scripts/check-links.mjs",
    "check:dmarc": "node scripts/read-dmarc.mjs",
    "test:seo": "vitest run --config vitest.build.config.ts",
    "test:browser": "playwright test",
    "test:frozen-panes": "playwright test tests/browser/frozen-panes.spec.ts --config playwright.frozen-panes.config.ts",
    "backup": "node scripts/backup.mjs",
    "check:grants": "node scripts/check-grants.mjs",
    "check:schema:parity": "node scripts/check-schema-parity.mjs",
    "staging:reset": "node scripts/reset-staging.mjs",
    "staging:seed-auth": "node scripts/seed-staging-auth.mjs",
    "test:browser:all": "playwright test --config playwright.crossbrowser.config.ts",
    "verify": "node scripts/verify.mjs",
    "verify:fast": "node scripts/verify.mjs --fast",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@sentry/nextjs": "10.75.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.112.2",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.0",
    "googleapis": "^181.0.0",
    "lucide-react": "^1.47.0",
    "next": "^16.3.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.3.0",
    "react-google-recaptcha": "^3.1.0",
    "resend": "^6.28.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "twilio": "^6.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-google-recaptcha": "^2.1.9",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^10",
    "eslint-config-next": "16.3.5",
    "jsdom": "^30.1.0",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vitest": "^4.1.10"
  }
}
