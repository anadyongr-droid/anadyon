{
  "description": "Anadyon: route every Codex tool call through the shared production gate. See codex-hooks-template.md beside this file.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "ABSOLUTE_PATH_TO_REPO/.claude/hooks/production-gate.mjs",
            "statusMessage": "Checking the production gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
